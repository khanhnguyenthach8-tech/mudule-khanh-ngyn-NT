#!url=
#!name=Locket Gold - thachkhanhs
#!desc=Module cấu hình Locket Widget - thachkhanhs Server
# 💬 IG: thachkhanhs
# 🚀 Rewrite by: Khánh NT

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]
# ~ Locket Gold - Shadowrocket / Surge / LanceX

# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/khanhnguyenthach8-tech/LK-G-GIAHAN/refs/heads/main/LK-GIAHAN.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/khanhnguyenthach8-tech/X-RCat/refs/heads/main/Untitled-1.js, timeout=60

# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/khanhnguyenthach8-tech/Feature/refs/heads/main/Untitled-1.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com

